{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(tree:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(node:*)",
      "Bash(uv:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(cargo:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(vercel:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(sudo:*)",
      "Read(./.vercel/**)"
    ],
    "ask": [
      "Bash(npx vercel deploy --prod:*)",
      "Bash(npx vercel --prod:*)",
      "Bash(npx vercel@latest deploy --prod:*)",
      "Bash(npx vercel@latest --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel --prod:*)",
      "Bash(git push:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
